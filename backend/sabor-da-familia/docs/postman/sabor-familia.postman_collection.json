{
  "info": {
    "name": "Sabor Família API",
    "description": "Collection da API Sabor Família.\n\n- Base URL: {{baseUrl}} (ex.: http://localhost:8080/api/sabor-familia)\n- Header X-User-Id: {{userId}} onde indicado (deve existir perfil.usuario_id correspondente)\n- Catálogo de personalização: /personalizacao/categorias, /personalizacao, /personalizacao/perfil e /personalizacao/receita.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/sabor-familia"
    },
    {
      "key": "userId",
      "value": "41"
    },
    {
      "key": "perfilId",
      "value": "41",
      "description": "ID em perfil.id (massa de dados: costuma alinhar com userId 1 → perfil 1)"
    },
    {
      "key": "receitaId",
      "value": "1",
      "description": "Preencha com o id retornado ao criar receita ou um id existente"
    },
    {
      "key": "personalizacaoCodigo",
      "value": "RAPIDA",
      "description": "Código em personalizacao.codigo (catálogo: GET /personalizacao ou listas planas /personalizacao/perfil | /receita)"
    },
    {
      "key": "nextBefore",
      "value": "",
      "description": "Cursor para paginação de mensagens (menor ID do lote anterior)"
    },
    {
      "key": "restricaoCodigo",
      "value": "GLUTEN",
      "description": "Código em restricao_alimentar.codigo (GET /restricao-alimentar/{codigo})"
    }
  ],
  "item": [
    {
      "name": "Receita",
      "item": [
        {
          "name": "Feed - Receitas do usuário e seguidos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/receita/feed?page=0&size=20&sort=dataCadastro,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receita",
                "feed"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "dataCadastro,desc"
                }
              ]
            }
          }
        },
        {
          "name": "Explorar receitas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/receita/explorar?page=0&size=20&sort=dataCadastro,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receita",
                "explorar"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "dataCadastro,desc"
                }
              ]
            },
            "description": "Explora receitas com filtros opcionais por tipo de refeição e título. A listagem prioriza receitas com mais aderência às preferências de personalização do usuário e, em empate, traz as mais recentes primeiro."
          }
        },
        {
          "name": "Buscar receita por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "type": "text",
                "disabled": false
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/receita/{{receitaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receita",
                "{{receitaId}}"
              ]
            },
            "description": "Retorna os detalhes completos da receita, incluindo autor, informações de preparo, estatísticas, restrições, personalizações e data de cadastro."
          }
        },
        {
          "name": "Listar receitas de um perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/receita/perfil/{{perfilId}}?page=0&size=20&sort=dataCadastro,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receita",
                "perfil",
                "{{perfilId}}"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "dataCadastro,desc"
                }
              ]
            },
            "description": "Lista receitas de um perfil em formato resumido, com paginação. Quando o usuário é informado, também indica se cada receita é restrita para ele."
          }
        },
        {
          "name": "Criar receita",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Bolo de chocolate\",\n  \"tipoRefeicao\": \"SOBREMESA\",\n  \"ingredientes\": \"Farinha, ovos, chocolate, açúcar\",\n  \"modoPreparo\": \"Misturar tudo e assar por 40 minutos\",\n  \"historia\": \"Receita da vovó\",\n  \"tempoPreparoMin\": 60,\n  \"qtdPorcoes\": 8,\n  \"restricoesAlimentares\": [\n    \"GLUTEN\",\n    \"LACTOSE\"\n  ],\n  \"personalizacoes\": [\n    \"RAPIDA\",\n    \"CONFORTO\",\n    \"USO_FORNO\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/receita",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receita"
              ]
            },
            "description": "Use personalizações com códigos ativos do catálogo. As restrições alimentares continuam no campo específico de restrições."
          }
        },
        {
          "name": "Atualizar receita",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Bolo de Capim\",\n  \"tipoRefeicao\": \"SOBREMESA\",\n  \"ingredientes\": \"Farinha, ovos, capim, açúcar e manteiga\",\n  \"modoPreparo\": \"Junte o campim em um campo de futebol ou pasto, misturar tudo e assar por 45 minutos\",\n  \"historia\": \"Era uma vez um bolo de capim\",\n  \"tempoPreparoMin\": 70,\n  \"qtdPorcoes\": 10,\n  \"restricoesAlimentares\": [\n    \"GLUTEN\"\n  ],\n  \"personalizacoes\": [\n    \"ECONOMICA\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/receita/{{receitaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receita",
                "{{receitaId}}"
              ]
            },
            "description": "Mesmo shape do POST **Criar receita** (campos na raiz)."
          }
        },
        {
          "name": "Remover receita",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
